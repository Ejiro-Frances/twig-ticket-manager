{# ticketcard.twig #}
<div class="bg-secondary/20 rounded-lg shadow-md p-6 relative hover:shadow-lg transition-shadow duration-300" x-data="{ showConfirm: false }">
    <div class="flex justify-between items-start mb-4">
        <h3 class="text-xl font-semibold text-secondary flex-1 mr-2">
            {{ ticket.title }}
        </h3>
        <div class="flex gap-2 shrink-0">
            <span class="px-2 py-1 rounded-full text-xs font-medium uppercase
                {% if ticket.status == 'OPEN' %}bg-green-100 text-green-900{% endif %}
                {% if ticket.status == 'IN_PROGRESS' %}bg-amber-100 text-amber-900{% endif %}
                {% if ticket.status == 'CLOSED' %}bg-green-100 text-green-950{% endif %}
            ">
                {{ ticket.status|replace({'_':' '}) }}
            </span>
            <span class="px-2 py-1 rounded-full text-xs font-medium uppercase
                {% if ticket.priority == 'HIGH' %}bg-red-100 text-error{% endif %}
                {% if ticket.priority == 'MEDIUM' %}bg-amber-100 text-amber-950{% endif %}
                {% if ticket.priority == 'LOW' %}bg-secondary/60 text-foreground{% endif %}
            ">
                {{ ticket.priority }}
            </span>
        </div>
    </div>

    <p class="text-foreground mb-4 min-h-12">
        {{ ticket.description ?: '' }}
    </p>

    <div class="flex justify-between items-center pt-4 border-t border-gray-200">
        <span class="text-xs text-foreground/70">
            Created: {{ ticket.createdAt|date('d/m/Y') }}
        </span>
        <span class="text-xs bg-secondary/20 px-1 py-0.5 rounded-md">
            ticket_{{ ticket.id }}
        </span>
        <div class="flex space-x-2">
            <a href="/tickets/edit/{{ ticket.id }}" class="px-3 py-1 border border-secondary text-secondary rounded-md hover:bg-primary hover:text-white transition-colors text-sm font-medium">
                Edit
            </a>
            <button class="border border-red-300 px-3 py-1 cursor-pointer text-white rounded-md hover:bg-red-600 transition-colors text-sm font-medium" @click="showConfirm = true">
                Delete
            </button>
        </div>
    </div>

    {# Confirmation modal #}
    <div x-show="showConfirm" class="fixed top-0 left-0 w-full h-screen z-50 flex justify-center items-center bg-black/60">
        <div class="bg-secondary bg-opacity-95 rounded-lg flex flex-col items-center justify-center p-6 animate-fade-in min-h-30">
            <p class="text-gray-800 mb-4 text-center">
                Are you sure you want to delete this ticket?
            </p>
            <div class="flex space-x-3">
                <button class="px-4 py-2 bg-primary text-foreground rounded-md hover:bg-primary/90 transition-colors font-medium" @click="showConfirm = false">
                    Cancel
                </button>
                <form method="POST" action="/tickets/delete/{{ ticket.id }}">
                    <button type="submit" class="border px-4 py-2 bg-error text-white rounded-md hover:bg-red-600 transition-colors font-medium">
                        Yes, Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
