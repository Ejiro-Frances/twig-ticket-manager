{# ticketpage.twig #}
{% extends 'base.twig' %}
{% set show_footer = false %}
{% block title %}Ticket Management{% endblock %}

{% block content %}
<div x-data="ticketPage()" x-init="init()">
    {# Dashboard Header #}
    {% include 'dashboardheader.twig' %}

    <main class="mt-30 px-5 md:px-7">
        <section>
            <h1 class="text-xl md:text-3xl text-foreground font-bold tracking-wide mb-3 mt-50 md:mt-0 pt-5">
                Ticket Management
            </h1>
            <p class="text-foreground">Create, view, edit and manage all your tickets</p>

            <button
                class="fixed top-28 right-10 bg-secondary text-white py-2 px-6 rounded-md hover:bg-primary-hover transition-colors font-medium"
                @click="openForm(null)"
            >
                Create New Ticket
            </button>
        </section>

        {# Ticket Form Modal #}
        <template x-if="showForm">
            {% include 'ticketform.twig' %}
        </template>

        {# Ticket Cards Grid #}
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3 mt-10">
            <template x-for="ticket in tickets" :key="ticket.id">
                <div class="bg-secondary/20 rounded-lg shadow-md p-6 relative hover:shadow-lg transition-shadow duration-300">
                    <div class="flex justify-between items-start mb-4">
                        <h3 class="text-xl font-semibold text-secondary flex-1 mr-2" x-text="ticket.title"></h3>
                        <div class="flex gap-2 shrink-0">
                            <span :class="statusClass(ticket.status)" class="px-2 py-1 rounded-full text-xs font-medium uppercase" x-text="ticket.status.replace('_',' ')"></span>
                            <span :class="priorityClass(ticket.priority)" class="px-2 py-1 rounded-full text-xs font-medium uppercase" x-text="ticket.priority"></span>
                        </div>
                    </div>
                    <p class="text-foreground mb-4 min-h-12" x-text="ticket.description"></p>

                    <div class="flex justify-between items-center pt-4 border-t border-gray-200">
                        <span class="text-xs text-foreground/70" x-text="'Created: ' + new Date(ticket.createdAt).toLocaleDateString('en-NG')"></span>
                        <span class="text-xs bg-secondary/20 px-1 py-0.5 rounded-md" x-text="'ticket_' + ticket.id"></span>
                        <div class="flex space-x-2">
                            <button @click="editTicket(ticket)" class="px-3 py-1 border border-secondary text-secondary rounded-md hover:bg-primary hover:text-white transition-colors text-sm font-medium cursor-pointer">Edit</button>
                            <button @click="deleteTicket(ticket.id)" class="border border-red-300 px-3 py-1 cursor-pointer text-white rounded-md hover:bg-red-600 transition-colors text-sm font-medium">Delete</button>
                        </div>
                    </div>
                </div>
            </template>
        </div>
    </main>
</div>

<script>
function ticketPage() {
    return {
        tickets: [],
        showForm: false,
        selectedTicket: null,

        init() {
            const stored = localStorage.getItem('tickets');
            this.tickets = stored ? JSON.parse(stored) : [];
        },

        statusClass(status) {
            switch(status) {
                case 'OPEN': return 'bg-green-100 text-green-900';
                case 'IN_PROGRESS': return 'bg-amber-100 text-amber-900';
                case 'CLOSED': return 'bg-gray-100 text-gray-950';
                default: return 'bg-foreground text-gray-600';
            }
        },

        priorityClass(priority) {
            switch(priority) {
                case 'HIGH': return 'bg-red-100 text-error';
                case 'MEDIUM': return 'bg-amber-100 text-amber-950';
                case 'LOW': return 'bg-secondary/60 text-foreground';
                default: return 'bg-gray-100 text-gray-600';
            }
        },

        openForm(ticket) {
            this.selectedTicket = ticket;
            this.showForm = true;
        },

        editTicket(ticket) {
            this.openForm(ticket);
        },

        deleteTicket(id) {
            if(!confirm('Are you sure you want to delete this ticket?')) return;
            this.tickets = this.tickets.filter(t => t.id !== id);
            localStorage.setItem('tickets', JSON.stringify(this.tickets));
        },

        saveTicket(data) {
            if(this.selectedTicket) {
                // Update existing
                this.tickets = this.tickets.map(t => t.id === this.selectedTicket.id ? {...t, ...data} : t);
            } else {
                // Create new
                const newTicket = {...data, id: Date.now(), createdAt: new Date().toISOString()};
                this.tickets.push(newTicket);
            }
            localStorage.setItem('tickets', JSON.stringify(this.tickets));
            this.showForm = false;
            this.selectedTicket = null;
        }
    }
}
</script>
{% endblock %}
