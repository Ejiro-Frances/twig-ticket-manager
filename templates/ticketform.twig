{# ticket_form.twig #}
<article class="fixed top-0 left-0 z-50 w-full h-screen bg-primary/70 backdrop-blur-xs flex justify-center items-center"
         x-data="{
             formData: {
                 title: '{{ ticket.title|default('')|e }}',
                 description: '{{ ticket.description|default('')|e }}',
                 status: '{{ ticket.status|default('OPEN') }}',
                 priority: '{{ ticket.priority|default('LOW') }}'
             },
             errors: {{ errors|default({})|json_encode|raw }},
             validate() {
                 this.errors = {};
                 if (!this.formData.title.trim()) {
                     this.errors.title = 'Title is required';
                 }
                 if (!['OPEN','IN_PROGRESS','CLOSED'].includes(this.formData.status)) {
                     this.errors.status = 'Status must be one of: OPEN, IN_PROGRESS, CLOSED';
                 }
                 if (this.formData.description.length > 500) {
                     this.errors.description = 'Description must be less than 500 characters';
                 }
                 return Object.keys(this.errors).length === 0;
             },
             submitForm(event) {
                 event.preventDefault();
                 if (this.validate()) {
                     $refs.ticketForm.submit();
                 }
             }
         }">

    <div class="max-w-2xl w-full border border-foreground rounded-md px-10 py-3 backdrop-blur-2xl shadow-2xl bg-primary">
        <h2 class="text-2xl font-bold text-foreground text-center mb-6">
            {{ ticket ? 'Edit Ticket' : 'Create New Ticket' }}
        </h2>

        <form x-ref="ticketForm" method="POST" action="{{ ticket ? '/tickets/edit/' ~ ticket.id : '/tickets/create' }}" @submit="submitForm" class="space-y-6">
            {# Title #}
            <div>
                <label for="title" class="block text-sm font-medium text-foreground mb-2">
                    Title <span class="text-error">*</span>
                </label>
                <input type="text" id="title" name="title" x-model="formData.title"
                       class="w-full px-4 py-2 border rounded-md focus:ring-2 focus:ring-primary focus:border-primary transition-colors"
                       :class="errors.title ? 'border-error' : 'border-gray-300'">
                <p x-text="errors.title" class="mt-1 text-sm text-error" x-show="errors.title"></p>
            </div>

            {# Description #}
            <div>
                <label for="description" class="block text-sm font-medium text-foreground mb-2">
                    Description <span class="italic text-foreground/70">(Optional)</span>
                </label>
                <textarea id="description" name="description" x-model="formData.description" rows="4"
                          class="w-full px-4 py-2 border rounded-md focus:ring-2 focus:ring-primary focus:border-primary transition-colors"
                          :class="errors.description ? 'border-error' : 'border-gray-300'"></textarea>
                <p x-text="errors.description" class="mt-1 text-sm text-error" x-show="errors.description"></p>
            </div>

            {# Status #}
            <div>
                <label for="status" class="block text-sm font-medium text-foreground mb-2">
                    Status <span class="text-error">*</span>
                </label>
                <select id="status" name="status" x-model="formData.status"
                        class="bg-primary/90 w-full px-4 py-2 border rounded-md focus:ring-2 focus:ring-primary focus:border-primary transition-colors"
                        :class="errors.status ? 'border-error' : 'border-gray-300'">
                    <option value="OPEN">Open</option>
                    <option value="IN_PROGRESS">In Progress</option>
                    <option value="CLOSED">Closed</option>
                </select>
                <p x-text="errors.status" class="mt-1 text-sm text-error" x-show="errors.status"></p>
            </div>

            {# Priority #}
            <div>
                <label for="priority" class="block text-sm font-medium text-foreground mb-2">
                    Priority
                </label>
                <select id="priority" name="priority" x-model="formData.priority"
                        class="bg-primary/90 w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-primary focus:border-primary transition-colors">
                    <option value="LOW">Low</option>
                    <option value="MEDIUM">Medium</option>
                    <option value="HIGH">High</option>
                </select>
            </div>

            {# Buttons #}
            <div class="grid grid-cols-2 gap-7 pt-4">
                <button type="button" @click="window.history.back()"
                        class="border border-secondary text-secondary py-2 px-6 rounded-md hover:bg-secondary/40 cursor-pointer transition-colors font-medium">
                    Cancel
                </button>
                <button type="submit"
                        class="bg-secondary text-foreground py-2 px-6 rounded-md hover:bg-secondary/40 cursor-pointer transition-colors font-medium">
                    {{ ticket ? 'Update Ticket' : 'Create Ticket' }}
                </button>
            </div>
        </form>
    </div>
</article>
