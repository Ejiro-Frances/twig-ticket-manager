<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Ticket Zen{% endblock %}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: 'oklch(19.171% 0.03836 230.362)',
                        foreground: 'oklch(0.985 0 0)',
                        secondary: 'oklch(75.236% 0.14929 235.166)',
                        accent: 'oklch(58.415% 0.23329 280.771)'
                    },
                     animation: {
                    float: 'float 6s ease-in-out infinite',
                },
                keyframes: {
                    float: {
                        '0%, 100%': { transform: 'translateY(0px)' },
                        '50%': { transform: 'translateY(-20px)' },
                    }
                }
                }
            }
        }
    </script>
</head>
<body>
    {% include 'navbar.twig' %}
    
    <main class="pt-20 bg-primary min-h-screen">
        {% block content %}{% endblock %}
    </main>

    {% if show_footer is not defined or show_footer %}
    {% include 'footer.twig' %}
    {% endif %}

</body>
<script src="https://unpkg.com/lucide@latest"></script>
<script>
  lucide.createIcons();
</script>

</html>